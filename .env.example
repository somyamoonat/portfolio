# Resend API Key for contact form delivery (https://resend.com)
# When not set, the contact API runs in simulated mode for local development.
RESEND_API_KEY=re_your_api_key_here

# Optional: Verified email address configured in Resend (default: onboarding@resend.dev)
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Optional: Destination email address (default: somya.moonat@gmail.com from profile.ts)
CONTACT_TO_EMAIL=somya.moonat@gmail.com
